{
  "name": "@xsd-tools/typescript",
  "version": "2.0.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "description": "Schema-driven XML parser generator for TypeScript",
  "keywords": [
    "xsd",
    "schema",
    "xml",
    "processing",
    "parser",
    "typescript"
  ],
  "author": "David Knezić <davidknezic@gmail.com>",
  "homepage": "https://github.com/pocketbitcoin/xsd-tools",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "bin": {
    "xsd-ts": "dist/bin/xsd-ts.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pocketbitcoin/xsd-tools.git"
  },
  "scripts": {
    "dev": "tsc --watch",
    "xsd-ts": "tsx src/bin/xsd-ts.ts",
    "build": "tsc",
    "prepublish": "npm run build",
    "test": "echo \"Error: run tests from root\" && exit 1",
    "check-types": "tsc --noEmit"
  },
  "bugs": {
    "url": "https://github.com/pocketbitcoin/xsd-tools/issues"
  },
  "peerDependencies": {
    "typescript": "catalog:",
    "xsd-tools": "workspace:*"
  },
  "dependencies": {
    "@xmldom/xmldom": "catalog:",
    "commander": "^14",
    "unzipper": "^0.12"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/unzipper": "^0.10",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "xsd-tools": "workspace:*"
  }
}
