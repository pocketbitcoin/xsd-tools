{
  "name": "@xsd-tools/typescript",
  "type": "module",
  "version": "0.2.0",
  "description": "Schema-driven XML parser generator for TypeScript",
  "keywords": [
    "xsd",
    "schema",
    "xml",
    "processing",
    "parser",
    "typescript"
  ],
  "author": "David Knezić <davidknezic@gmail.com>",
  "homepage": "https://github.com/pocketbitcoin/xsd-tools",
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "bin": {
    "xsd-ts": "dist/bin/xsd-ts.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pocketbitcoin/xsd-tools.git"
  },
  "scripts": {
    "dev": "tsc --watch",
    "xsd-ts": "tsx src/bin/xsd-ts.ts",
    "build": "tsc",
    "prepublish": "npm run build",
    "test": "echo \"Error: run tests from root\" && exit 1"
  },
  "bugs": {
    "url": "https://github.com/pocketbitcoin/xsd-tools/issues"
  },
  "peerDependencies": {
    "typescript": "catalog:",
    "xsd-tools": "workspace:*"
  },
  "dependencies": {
    "commander": "^14",
    "node-fetch": "^3",
    "unzipper": "^0.12.3",
    "xmldom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/unzipper": "^0.10.11",
    "@types/xmldom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "xsd-tools": "workspace:*"
  }
}
